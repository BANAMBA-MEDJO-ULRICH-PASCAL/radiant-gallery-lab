---
import { profile, socials, type Locale } from "@/config/site";
import { useTranslations, localePath } from "@/i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Links without a URL yet are dropped rather than rendered as dead anchors.
const liveSocials = socials.filter(
  (s): s is (typeof socials)[number] & { href: string } => Boolean(s.href),
);

const year = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-5xl px-6 py-10">
  <div
    class="flex flex-col items-start justify-between gap-4 border-b border-brown/10 pb-8 sm:flex-row sm:items-center"
  >
    <a href={localePath(lang)} class="font-display text-xl text-brown">
      {profile.name}
    </a>
    <div class="flex flex-wrap gap-5 text-sm text-bark">
      {
        liveSocials.map((s) => (
          <a
            href={s.href}
            class="transition-transform hover:-translate-y-0.5"
            rel="noopener noreferrer"
            target="_blank"
          >
            {s.label}
          </a>
        ))
      }
      <a href={`mailto:${profile.email}`} class="transition-transform hover:-translate-y-0.5">
        Email
      </a>
    </div>
  </div>
  <div class="mt-6 flex flex-col gap-1 text-sm text-bark/70 sm:flex-row sm:justify-between">
    <p>{t("footer.madeWith")} © {year}</p>
    <p>{t("footer.basedIn")}</p>
  </div>
</footer>
