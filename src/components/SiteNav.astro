---
import { profile, type Locale } from "@/config/site";
import {
  useTranslations,
  localePath,
  alternatePath,
  otherLocale,
  HTML_LANG,
} from "@/i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const other = otherLocale(lang);

const navItems = [
  { label: t("nav.work"), href: localePath(lang, "work") },
  { label: t("nav.services"), href: localePath(lang, "services") },
  { label: t("nav.certifications"), href: localePath(lang, "certifications") },
  { label: t("nav.blog"), href: localePath(lang, "blog") },
  { label: t("nav.about"), href: localePath(lang, "about") },
];

/** Mark the current section, including nested pages like /work/sentinel/. */
const current = Astro.url.pathname.replace(/\/+$/, "") + "/";
const isActive = (href: string) => current === href || current.startsWith(href);

const switchHref = alternatePath(Astro.url, other);
---

<header class="relative z-50">
  <nav
    class="mx-auto flex max-w-5xl items-center gap-4 px-6 py-6"
    aria-label={t("nav.menu")}
  >
    {/* `shrink-0` and the gap above are what stop the name colliding with the
        first nav link on medium widths. */}
    <a
      href={localePath(lang)}
      class="shrink-0 font-display text-2xl whitespace-nowrap text-brown transition-transform hover:-translate-y-0.5"
    >
      {profile.name}
    </a>

    <div class="ml-auto flex items-center gap-3 text-sm text-bark sm:gap-5">
      <div class="hidden items-center gap-5 lg:flex">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                "transition-transform hover:-translate-y-0.5",
                isActive(item.href) && "font-semibold text-terracotta",
              ]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <a
        href={switchHref}
        hreflang={HTML_LANG[other]}
        class="hidden rounded-full px-3 py-1.5 font-medium ring-1 ring-brown/15 transition-transform hover:-translate-y-0.5 sm:inline-block"
        aria-label={t("nav.switchLanguage")}
      >
        {t("nav.switchLanguage")}
      </a>

      <button
        type="button"
        id="theme-toggle"
        class="grid size-9 shrink-0 place-items-center rounded-full ring-1 ring-brown/15 transition-transform hover:-translate-y-0.5"
        aria-label={t("nav.toggleTheme")}
      >
        <svg
          class="size-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
        <svg
          class="hidden size-4 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <a
        href={localePath(lang, "contact")}
        class="hidden shrink-0 rounded-full bg-terracotta px-4 py-2 font-semibold whitespace-nowrap text-cream transition-transform hover:-translate-y-0.5 sm:inline-block"
      >
        {t("nav.contact")}
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="grid size-9 shrink-0 place-items-center rounded-full ring-1 ring-brown/15 lg:hidden"
        aria-label={t("nav.menu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="mx-auto hidden max-w-5xl px-6 pb-6 lg:hidden"
  >
    <div class="flex flex-col gap-1 rounded-3xl bg-cream/90 p-4 ring-1 ring-brown/10 backdrop-blur-sm">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-2xl px-4 py-3 text-sm transition-colors hover:bg-paper/60",
              isActive(item.href) ? "font-semibold text-terracotta" : "text-bark",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={switchHref}
        hreflang={HTML_LANG[other]}
        class="rounded-2xl px-4 py-3 text-sm text-bark transition-colors hover:bg-paper/60 sm:hidden"
      >
        {t("nav.switchLanguage")}
      </a>
      <a
        href={localePath(lang, "contact")}
        class="mt-2 rounded-full bg-terracotta px-4 py-3 text-center text-sm font-semibold text-cream"
      >
        {t("nav.contact")}
      </a>
    </div>
  </div>
</header>

<script>
  // Theme toggle — persists the choice, falling back silently when storage is
  // unavailable (private windows, blocked site data).
  const themeToggle = document.getElementById("theme-toggle");
  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch {
      /* Preference just won't persist; the page still switches. */
    }
  });

  // Mobile menu.
  const menuToggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  menuToggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    menuToggle.setAttribute("aria-expanded", String(open));
  });

  // Close the menu on Escape so keyboard users aren't trapped.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || menu?.classList.contains("hidden")) return;
    menu?.classList.add("hidden");
    menuToggle?.setAttribute("aria-expanded", "false");
    (menuToggle as HTMLButtonElement | null)?.focus();
  });
</script>
