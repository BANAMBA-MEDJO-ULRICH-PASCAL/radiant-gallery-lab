---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/karla";
import "@/styles/global.css";

import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import BackgroundOrbs from "@/components/BackgroundOrbs.astro";

import { SITE_URL, profile, type Locale } from "@/config/site";
import { useTranslations, alternatePath, otherLocale, HTML_LANG } from "@/i18n/utils";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Path to a social preview image, relative to the site root. */
  ogImage?: string;
  /** Set on article pages so the type is right in Open Graph. */
  type?: "website" | "article";
  /** Extra JSON-LD to merge in, already shaped as a schema.org object. */
  structuredData?: Record<string, unknown>;
}

const {
  lang,
  title,
  description,
  ogImage = "/og-default.png",
  type = "website",
  structuredData,
} = Astro.props;

const t = useTranslations(lang);
const other = otherLocale(lang);

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const alternateHref = new URL(alternatePath(Astro.url, other), SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;

// Page title: skip the suffix on the homepage, which already carries the name.
const isHome = Astro.url.pathname.replace(/\/+$/, "").split("/").filter(Boolean).length <= 1;
const fullTitle = isHome ? title : `${title} — ${profile.name}`;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.legalName,
  alternateName: profile.name,
  url: SITE_URL,
  email: `mailto:${profile.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: profile.location.city,
    addressCountry: profile.location.countryCode,
  },
  knowsLanguage: ["en", "fr"],
};
---

<!doctype html>
<html lang={HTML_LANG[lang]} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang={HTML_LANG[lang]} href={canonical} />
    <link rel="alternate" hreflang={HTML_LANG[other]} href={alternateHref} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternatePath(Astro.url, "en"), SITE_URL).href} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_GB"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="author" content={profile.legalName} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profile.name} — ${t("blog.title")}`}
      href={`/rss-${lang}.xml`}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
      is:inline
    />
    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
          is:inline
        />
      )
    }

    {/*
      Runs before first paint so the correct theme is applied without a flash,
      and removes `.no-js` so CSS can safely hide elements it will animate in.
      Inline by necessity — it must execute before the body renders.
    */}
    <script is:inline>
      (function () {
        document.documentElement.classList.remove("no-js");
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (stored === "dark" || (!stored && prefersDark)) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {
          /* Private mode or blocked storage — fall back to the light theme. */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{t("nav.skipToContent")}</a>

    <div class="relative min-h-screen overflow-hidden bg-paper text-brown">
      <BackgroundOrbs />
      <div class="relative flex min-h-screen flex-col">
        <SiteNav lang={lang} />
        <main id="main" class="flex-1">
          <slot />
        </main>
        <SiteFooter lang={lang} />
      </div>
    </div>

    <script>
      // Scroll-triggered reveals. Elements marked `.reveal` fade up as they
      // enter the viewport, then stop being observed so the work is done once.
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = document.querySelectorAll<HTMLElement>(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
