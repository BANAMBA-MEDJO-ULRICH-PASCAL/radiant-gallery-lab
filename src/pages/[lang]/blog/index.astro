---
import { Image } from "astro:assets";

import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";

import { type Locale } from "@/config/site";
import { useTranslations, localePath, localeStaticPaths, formatDate } from "@/i18n/utils";
import { getPosts, entrySlug } from "@/lib/content";

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const posts = await getPosts(lang);
---

<BaseLayout {lang} title={t("blog.title")} description={t("blog.lead")}>
  <div class="mx-auto max-w-4xl px-6 pb-16">
    <PageHeader title={t("blog.title")} lead={t("blog.lead")} />

    {
      posts.length === 0 ? (
        <p class="rounded-[28px] bg-cream/60 p-8 text-sm text-bark ring-1 ring-brown/10">
          {t("blog.empty")}
        </p>
      ) : (
        <div class="space-y-6">
          {posts.map((post) => (
            <article class="reveal relative flex gap-6 rounded-[28px] bg-cream/80 p-6 ring-1 ring-brown/10 transition-transform hover:-translate-y-1">
              {post.data.cover && (
                <Image
                  src={post.data.cover}
                  alt={post.data.coverAlt ?? ""}
                  widths={[200, 400]}
                  sizes="160px"
                  loading="lazy"
                  class="hidden size-32 shrink-0 rounded-[20px] object-cover ring-1 ring-brown/5 sm:block"
                />
              )}
              <div>
                <p class="text-xs text-bark/70">{formatDate(post.data.date, lang)}</p>
                <h2 class="mt-1 font-display text-xl text-brown">
                  <a
                    href={localePath(lang, `blog/${entrySlug(post.id)}`)}
                    class="after:absolute after:inset-0"
                  >
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-2 text-sm text-bark">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="rounded-full bg-amber/20 px-3 py-1 text-xs font-medium text-brown">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
