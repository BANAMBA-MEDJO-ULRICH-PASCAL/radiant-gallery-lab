---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";

import { PILLARS, type Locale } from "@/config/site";
import { useTranslations, localePath, localeStaticPaths } from "@/i18n/utils";
import { serviceCopy } from "@/data/services";
import type { UIKey } from "@/i18n/ui";

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const copy = serviceCopy[lang];

const crafts = (["build", "market"] as const).map((craft) => ({
  craft,
  title: t(`craft.${craft}.title` as UIKey),
  tagline: t(`craft.${craft}.tagline` as UIKey),
  dot: craft === "build" ? "bg-terracotta" : "bg-amber",
  pillars: PILLARS.filter((p) => p.craft === craft),
}));
---

<BaseLayout {lang} title={t("services.title")} description={t("services.lead")}>
  <div class="mx-auto max-w-5xl px-6 pb-16">
    <PageHeader title={t("services.title")} lead={t("services.lead")} />

    {
      crafts.map((craft) => (
        <section class="mb-14">
          <div class="reveal mb-6">
            <h2 class="font-display text-2xl text-brown">{craft.title}</h2>
            <p class="mt-1 text-sm text-bark">{craft.tagline}</p>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            {craft.pillars.map((pillar) => (
              <div class="reveal rounded-[28px] bg-cream/80 p-7 ring-1 ring-brown/10 backdrop-blur-sm">
                <h3 class="font-display text-xl text-brown">
                  {t(`pillar.${pillar.id}.name` as UIKey)}
                </h3>
                <p class="mt-1 text-xs tracking-wide text-bark/70 uppercase">
                  {t(`pillar.${pillar.id}.short` as UIKey)}
                </p>
                <p class="mt-3 text-sm text-bark">{copy[pillar.id].detail}</p>
                <ul class="mt-4 space-y-2 text-sm text-bark">
                  {copy[pillar.id].deliverables.map((item) => (
                    <li class="flex items-start gap-3">
                      <span class:list={["mt-1.5 size-1.5 shrink-0 rounded-full", craft.dot]} />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <div
      class="reveal rounded-[32px] bg-cream/80 p-8 text-center ring-1 ring-brown/10 backdrop-blur-sm sm:p-12"
    >
      <h2 class="font-display text-3xl leading-tight text-brown">
        {t("home.finalCta.title")}
      </h2>
      <p class="mx-auto mt-3 max-w-md text-base text-bark">{t("home.finalCta.body")}</p>
      <a
        href={localePath(lang, "contact")}
        class="mt-6 inline-block rounded-full bg-terracotta px-6 py-3 text-base font-semibold text-cream transition-transform hover:-translate-y-0.5"
      >
        {t("home.cta.primary")}
      </a>
    </div>
  </div>
</BaseLayout>
